{
	"name": "devenv",
    "image": "ghcr.io/lucasvmigotto/devenv/debian:trixie",
	"runArgs": [
        "--rm",
        "--env-file", ".env"
    ],
    "remoteUser": "developer",
    "mounts": [
        {
            "source": "/var/run/docker.sock",
            "target": "/var/run/docker.sock",
            "type": "bind"

        },
        {
            "source": "devcontainer-java-tbt-extensions",
            "target": "/root/.vscode-server/extensions",
            "type": "volume"
        }
    ],
	"features": {
        "ghcr.io/devcontainers/features/docker-in-docker:2": {}
	},
    "postCreateCommand": "curl --proto '=https' --tlsv1.2 -sSf https://raw.githubusercontent.com/nektos/act/master/install.sh | bash",
    "customizations": {
		"vscode": {
			"extensions": [
				// Development
                "ms-azuretools.vscode-docker",
                "docker.docker",
                // DevOps
                "GitHub.vscode-github-actions",
                "SanjulaGanepola.github-local-actions",
				// Style and Linting
				"DavidAnson.vscode-markdownlint",
                "Cardinal90.multi-cursor-case-preserve",
				"redhat.vscode-yaml",
				// Utils
				"EditorConfig.EditorConfig",
				"mhutchie.git-graph",
				"ryu1kn.partial-diff",
				"njzy.stats-bar",
				"christian-kohler.path-intellisense",
				// Miscellaneous
				"streetsidesoftware.code-spell-checker",
				"streetsidesoftware.code-spell-checker-portuguese-brazilian"
			]
		}
	}
}
